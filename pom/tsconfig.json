{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "playwright"]
  },
  "include": ["tests for Org and Edu , MSA accounts/**/*.ts", "pages/**/*.ts", "playwright.config.ts", "MSA Tests/MSATests for Chrome and Edge.spec.ts"]
}
